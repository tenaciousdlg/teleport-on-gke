export TF_VAR_project_id="your-gcp-project-id"
export TF_VAR_region="us-central1"
export TF_VAR_user="you@example.com"
export TF_VAR_proxy_address="teleport.corp.example.com"
export TF_VAR_teleport_version="18.6.4"
export TF_VAR_testbed_name="testbed-alpha"
export TF_VAR_env="dev"
export TF_VAR_team="platform"

# Control plane GKE cluster connection info.
# Obtain from 1-cluster outputs after running terraform apply there:
#   TF_VAR_control_plane_cluster_endpoint=$(terraform -chdir=../../control-plane/gke/1-cluster output -raw cluster_endpoint)
#   TF_VAR_control_plane_cluster_ca_certificate=$(terraform -chdir=../../control-plane/gke/1-cluster output -raw cluster_ca_certificate)
#   TF_VAR_control_plane_cluster_token=$(gcloud auth print-access-token)
# Control plane VPC name — testbed subnet is placed here so it can reach the
# internal L4 LB (passthrough ILBs are not accessible from peered VPCs or VPN).
# Derive: terraform -chdir=../../control-plane/1-cluster output -raw network_name
export TF_VAR_control_plane_network_name="presales-gke-vpc"

export TF_VAR_control_plane_cluster_endpoint="https://1.2.3.4"
export TF_VAR_control_plane_cluster_ca_certificate="LS0t..."
export TF_VAR_control_plane_cluster_token="$(gcloud auth print-access-token)"
